<?xml version='1.0' encoding='UTF-8'?>
<root>
 <tabbed_widget parent="main_window" name="Main Window">
  <Tab tab_name="Beccheggio &amp; Coppia" containers="1">
   <Container>
    <DockSplitter count="2" orientation="-" sizes="0.5;0.5">
     <DockArea name="Beccheggio">
      <plot style="Lines" mode="TimeSeries" flip_y="false" flip_x="false">
       <range top="2" bottom="-2" left="0" right="25"/>
       <limitY/>
       <curve color="#1f77b4" name="theta_deg"/>
       <curve color="#000000" name="theta_ref_deg"/>
      </plot>
     </DockArea>
     <DockArea name="Coppia Ruote">
      <plot style="Lines" mode="TimeSeries" flip_y="false" flip_x="false">
       <range top="5" bottom="-5" left="0" right="25"/>
       <limitY/>
       <curve color="#d62728" name="wheel_L_torque_cmd"/>
       <curve color="#2ca02c" name="wheel_R_torque_cmd"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Errori di Inseguimento" containers="1">
   <Container>
    <DockSplitter count="2" orientation="-" sizes="0.5;0.5">
     <DockArea name="Errore Beccheggio">
      <plot style="Lines" mode="TimeSeries" flip_y="false" flip_x="false">
       <range top="2" bottom="-2" left="0" right="25"/>
       <limitY/>
       <curve color="#e74c3c" name="theta_err_deg"/>
      </plot>
     </DockArea>
     <DockArea name="Errore Posizione &amp; Quota">
      <plot style="Lines" mode="TimeSeries" flip_y="false" flip_x="false">
       <range top="0.5" bottom="-0.5" left="0" right="25"/>
       <limitY/>
       <curve color="#3498db" name="s_err_m"/>
       <curve color="#2ecc71" name="com_z_err_mm"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Disturbo &amp; offset CoM" containers="1">
   <Container>
    <DockSplitter count="2" orientation="-" sizes="0.5;0.5">
     <DockArea name="Offset CoM desiderato (delta_s)">
      <plot style="Lines" mode="TimeSeries" flip_y="false" flip_x="false">
       <range top="0.05" bottom="-0.05" left="0" right="25"/>
       <limitY/>
       <curve color="#9b59b6" name="delta_s_m"/>
      </plot>
     </DockArea>
     <DockArea name="Forza Disturbo Impulso">
      <plot style="Lines" mode="TimeSeries" flip_y="false" flip_x="false">
       <range top="250" bottom="0" left="0" right="25"/>
       <limitY/>
       <curve color="#e67e22" name="push_force_N"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Posizione &amp; Velocita" containers="1">
   <Container>
    <DockSplitter count="2" orientation="-" sizes="0.5;0.5">
     <DockArea name="Posizione Lineare">
      <plot style="Lines" mode="TimeSeries" flip_y="false" flip_x="false">
       <range top="1" bottom="-1" left="0" right="25"/>
       <limitY/>
       <curve color="#ff7f0e" name="x_m"/>
       <curve color="#000000" name="s_ref_m"/>
      </plot>
     </DockArea>
     <DockArea name="Velocita Lineare">
      <plot style="Lines" mode="TimeSeries" flip_y="false" flip_x="false">
       <range top="1" bottom="-1" left="0" right="25"/>
       <limitY/>
       <curve color="#9467bd" name="xdot_ms"/>
       <curve color="#000000" name="xdot_ref_ms"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Quota CoM &amp; Forze di Contatto" containers="1">
   <Container>
    <DockSplitter count="2" orientation="-" sizes="0.5;0.5">
     <DockArea name="Quota CoM">
      <plot style="Lines" mode="TimeSeries" flip_y="false" flip_x="false">
       <range top="0.3" bottom="0.1" left="0" right="25"/>
       <limitY/>
       <curve color="#17becf" name="com_z_m"/>
       <curve color="#000000" name="com_z_ref_m"/>
      </plot>
     </DockArea>
     <DockArea name="Forza di Contatto al Suolo">
      <plot style="Lines" mode="TimeSeries" flip_y="false" flip_x="false">
       <range top="150" bottom="0" left="0" right="25"/>
       <limitY/>
       <curve color="#8c564b" name="fn_total_N"/>
       <curve color="#e377c2" name="fn_left_N"/>
       <curve color="#7f7f7f" name="fn_right_N"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
