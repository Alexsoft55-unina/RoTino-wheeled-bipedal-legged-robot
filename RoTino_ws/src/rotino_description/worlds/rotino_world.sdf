        <collision name="plateau_collision"><pose>-6.5 0 0.015 0 0 0</pose><geometry><box><size>1.8 2.0 0.03</size></box></geometry><surface><friction><ode><mu>2.2</mu><mu2>2.2</mu2></ode></friction></surface></collision>
