<?xml version="1.0"?>
<sdf version="1.8">
  <world name="rotino_world">
    <!-- 0.5 ms physics keeps the explicit leg-servo damping (kv 14) numerically stable;
         control and odometry run at 500 Hz, an exact multiple, so their stamps coincide. -->
    <physics name="0_5ms" type="ignored">
      <max_step_size>0.0005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>
    <!-- /world/rotino_world/wrench: one-step wrench, used for the impact-recovery test -->
    <plugin filename="ignition-gazebo-apply-link-wrench-system" name="ignition::gazebo::systems::ApplyLinkWrench"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 -3 4 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.2 0.3 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
          <!-- DART combines friction with min(mu_a, mu_b), MuJoCo with max. Ground mu = 2.2 makes every
               robot/ground pair match MuJoCo: wheels 2.2, legs/torso 1.8. -->
          <surface>
            <friction><ode><mu>2.2</mu><mu2>2.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
          <material>
            <ambient>0.62 0.61 0.58 1</ambient>
            <diffuse>0.62 0.61 0.58 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <pbr><metal><roughness>0.9</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_collision"><pose>0 15.1 0.3 0 0 0</pose><geometry><box><size>40.4 0.2 0.6</size></box></geometry><surface><friction><ode><mu>2.2</mu><mu2>2.2</mu2></ode></friction></surface></collision>
        <visual name="north_visual"><pose>0 15.1 0.3 0 0 0</pose><geometry><box><size>40.4 0.2 0.6</size></box></geometry><material><ambient>0.8 0.78 0.74 1</ambient><diffuse>0.8 0.78 0.74 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="south_collision"><pose>0 -15.1 0.3 0 0 0</pose><geometry><box><size>40.4 0.2 0.6</size></box></geometry><surface><friction><ode><mu>2.2</mu><mu2>2.2</mu2></ode></friction></surface></collision>
        <visual name="south_visual"><pose>0 -15.1 0.3 0 0 0</pose><geometry><box><size>40.4 0.2 0.6</size></box></geometry><material><ambient>0.8 0.78 0.74 1</ambient><diffuse>0.8 0.78 0.74 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="east_collision"><pose>20.1 0 0.3 0 0 0</pose><geometry><box><size>0.2 30 0.6</size></box></geometry><surface><friction><ode><mu>2.2</mu><mu2>2.2</mu2></ode></friction></surface></collision>
        <visual name="east_visual"><pose>20.1 0 0.3 0 0 0</pose><geometry><box><size>0.2 30 0.6</size></box></geometry><material><ambient>0.8 0.78 0.74 1</ambient><diffuse>0.8 0.78 0.74 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="west_collision"><pose>-20.1 0 0.3 0 0 0</pose><geometry><box><size>0.2 30 0.6</size></box></geometry><surface><friction><ode><mu>2.2</mu><mu2>2.2</mu2></ode></friction></surface></collision>
        <visual name="west_visual"><pose>-20.1 0 0.3 0 0 0</pose><geometry><box><size>0.2 30 0.6</size></box></geometry><material><ambient>0.8 0.78 0.74 1</ambient><diffuse>0.8 0.78 0.74 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Uneven ground, away from the benchmark paths (all within ~3.5 m of the start): speed bumps ahead, a ramp
         with a 3 cm plateau behind, a patch of low tiles on the right. Same friction as the ground. The model name
         contains "ground" because the controllers count as ground contact only collisions with that word. -->
    <model name="ground_uneven">
      <static>true</static>
      <link name="link">
        <collision name="bump0_collision"><pose>6.0 0 -0.08 1.5708 0 0</pose><geometry><cylinder><radius>0.10</radius><length>2.0</length></cylinder></geometry><surface><friction><ode><mu>2.2</mu><mu2>2.2</mu2></ode></friction></surface></collision>
        <visual name="bump0_visual"><pose>6.0 0 -0.08 1.5708 0 0</pose><geometry><cylinder><radius>0.10</radius><length>2.0</length></cylinder></geometry><material><ambient>0.85 0.7 0.15 1</ambient><diffuse>0.85 0.7 0.15 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="bump1_collision"><pose>6.8 0 -0.08 1.5708 0 0</pose><geometry><cylinder><radius>0.10</radius><length>2.0</length></cylinder></geometry><surface><friction><ode><mu>2.2</mu><mu2>2.2</mu2></ode></friction></surface></collision>
        <visual name="bump1_visual"><pose>6.8 0 -0.08 1.5708 0 0</pose><geometry><cylinder><radius>0.10</radius><length>2.0</length></cylinder></geometry><material><ambient>0.85 0.7 0.15 1</ambient><diffuse>0.85 0.7 0.15 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
