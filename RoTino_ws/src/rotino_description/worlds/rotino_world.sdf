        <visual name="bump2_visual"><pose>7.6 0 -0.08 1.5708 0 0</pose><geometry><cylinder><radius>0.10</radius><length>2.0</length></cylinder></geometry><material><ambient>0.85 0.7 0.15 1</ambient><diffuse>0.85 0.7 0.15 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="ramp_up_collision"><pose>-5.3025 0.000 -0.0349 0 0.04996 0</pose><geometry><box><size>0.6007 2.0 0.1</size></box></geometry><surface><friction><ode><mu>2.2</mu><mu2>2.2</mu2></ode></friction></surface></collision>
