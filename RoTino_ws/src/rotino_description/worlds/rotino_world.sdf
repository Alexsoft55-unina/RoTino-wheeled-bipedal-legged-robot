    </model>

    <!-- Static anchor holding the RoTino torso upright at its spawn pose until the balance
         controller publishes /rotino/release. The anchor must be the joint PARENT: DART moves the
         child body into the parent's skeleton, so with the robot as parent the anchor would lose
         its weld to the world and hold nothing. -->
    <model name="rotino_anchor">
      <static>true</static>
      <pose>0 0 0.2439 0 0 0</pose>
      <link name="anchor_link">
        <visual name="visual">
          <geometry><sphere><radius>0.01</radius></sphere></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-detachable-joint-system" name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>anchor_link</parent_link>
        <child_model>rotino</child_model>
        <child_link>base_link</child_link>
        <detach_topic>/rotino/release</detach_topic>
      </plugin>
    </model>

  </world>
</sdf>
